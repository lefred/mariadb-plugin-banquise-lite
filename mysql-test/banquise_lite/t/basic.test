SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE
  FROM INFORMATION_SCHEMA.PLUGINS
  WHERE PLUGIN_NAME = 'BANQUISE_CATALOG';

SHOW COLUMNS FROM INFORMATION_SCHEMA.BANQUISE_CATALOG;
SELECT COUNT(*) FROM INFORMATION_SCHEMA.BANQUISE_CATALOG;
SHOW STATUS LIKE 'banquise_lite_message';
SHOW VARIABLES LIKE 'banquise_lite_%';
SELECT PLUGIN_NAME, PLUGIN_TYPE
  FROM INFORMATION_SCHEMA.PLUGINS
  WHERE PLUGIN_NAME LIKE 'banquise_lite_%'
  ORDER BY PLUGIN_NAME;

--error ER_UNKNOWN_ERROR
SELECT banquise_lite_install('vmstat');
SHOW STATUS LIKE 'banquise_lite_message';

--error ER_UNKNOWN_ERROR
SELECT banquise_lite_update('vmstat');
--error ER_UNKNOWN_ERROR
SELECT banquise_lite_uninstall('vmstat');
