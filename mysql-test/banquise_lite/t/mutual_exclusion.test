--error ER_UDF_EXISTS
INSTALL SONAME 'banquise_agent';

SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE
  FROM INFORMATION_SCHEMA.PLUGINS
  WHERE PLUGIN_NAME IN ('BANQUISE_LITE', 'BANQUISE_AGENT', 'BANQUISE_CATALOG')
  ORDER BY PLUGIN_NAME;

SELECT COUNT(*) >= 0 AS catalog_available
  FROM INFORMATION_SCHEMA.BANQUISE_CATALOG;
